{
  "name": "sprite-amimate",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run build:lib && rsbuild dev",
    "build": "rsbuild build && rsbuild build --config rsbuild.lib.config.ts",
    "icons": "svgforge -C svgforge.json  'src/icons/./**/*.svg'",
    "preview": "rsbuild preview",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "build:lib": "rsbuild build --config rsbuild.lib.config.ts",
    "release": "npm run build"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@rsbuild/core": "^1.7.6",
    "@types/node": "^26.6.2",
    "typescript": "^5.6.2"
  },
  "dependencies": {
    "@svgforge/svgforge": "3.0.0-beta.1",
    "gsap": "^3.15.0"
  },
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=24",
    "pnpm": ">=12"
  }
}
